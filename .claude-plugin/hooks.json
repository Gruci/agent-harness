{
  "description": "agent-harness core gates. They act only in repos that have harness_profile.py and no template kernel.",
  "hooks": {
    "SessionStart": [{"matcher": "startup|resume|clear|compact", "hooks": [
      {"type": "command", "timeout": 15,
       "command": "python -X utf8 \"${CLAUDE_PLUGIN_ROOT}/kernel\" session || echo '[HARNESS] python 을 실행하지 못했다 — python 3.10 이상이 없으면 게이트가 하나도 돌지 않는다.'"}]}],
    "PreToolUse": [{"matcher": "Bash|PowerShell", "hooks": [
      {"type": "command", "timeout": 15,
       "command": "python -X utf8 \"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/check_bash_write.py\" --plugin"},
      {"type": "command", "timeout": 180,
       "command": "python -X utf8 \"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/check_pretool.py\" --plugin"}]}],
    "PostToolUse": [{"matcher": "Edit|Write|MultiEdit", "hooks": [
      {"type": "command", "timeout": 60,
       "command": "python -X utf8 \"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/check_file_rules.py\" --plugin"}]}],
    "Stop": [{"hooks": [
      {"type": "command", "timeout": 120,
       "command": "python -X utf8 \"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/check_coding_rules.py\" --plugin"}]}]
  }
}
