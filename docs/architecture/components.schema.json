{
  "type": "object",
  "properties": {
    "schema": {
      "const": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "roles"
        ],
        "additionalProperties": false
      }
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "responsibility": {
            "type": "string",
            "minLength": 1
          },
          "excludes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "root": {
            "type": "string",
            "minLength": 1
          },
          "roles": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          },
          "public": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "module": {
                  "type": "string",
                  "minLength": 1
                },
                "symbols": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true
                }
              },
              "required": [
                "id",
                "module",
                "symbols"
              ],
              "additionalProperties": false
            }
          },
          "state": {
            "enum": [
              "planned",
              "implemented",
              "retired"
            ]
          },
          "external": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "ports": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "object",
              "properties": {
                "module": {"type": "string", "minLength": 1},
                "symbol": {"type": "string", "minLength": 1},
                "fake_module": {"type": "string", "minLength": 1},
                "fake_symbol": {"type": "string", "minLength": 1},
                "test_module": {"type": "string", "minLength": 1}
              },
              "required": ["module", "symbol", "fake_module", "fake_symbol", "test_module"],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "name",
          "category",
          "responsibility",
          "excludes",
          "root",
          "roles",
          "public",
          "state",
          "external"
        ],
        "additionalProperties": false
      }
    },
    "edges": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "contract": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "import"
            ]
          }
        },
        "required": [
          "source",
          "target",
          "contract",
          "kind"
        ],
        "additionalProperties": false
      }
    },
    "technology": {
      "type": "object",
      "properties": {
        "sources": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "syntax": {
          "type": "string",
          "minLength": 1
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "path",
              "reason"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "sources",
        "syntax"
      ],
      "additionalProperties": false
